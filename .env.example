# --- Database ---
# Local dev default (SQLite, zero setup):
DATABASE_URL="file:./dev.db"
# Production: point at Postgres instead, e.g.
# DATABASE_URL="postgresql://user:password@host:5432/adpac"
# (also change `provider` in prisma/schema.prisma to "postgresql")

# --- App auth (NextAuth) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
# Local dev runs on port 3010 (set via `npm run dev`'s -p flag in
# package.json) instead of the Next.js default 3000, so it doesn't collide
# with other local projects. Change both the port here and the -p flag in
# package.json together if you want a different port.
NEXTAUTH_URL="http://localhost:3010"

# --- Token encryption ---
# Encrypts client refresh tokens before they touch the database.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY="replace-with-a-random-32-byte-hex-key"

# --- Google Ads API ---
# From Google Cloud Console (OAuth client) — see README "Google Ads setup"
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_REDIRECT_URI="http://localhost:3010/api/google-ads/callback"
# From the Google Ads API Center, under your Manager (MCC) account
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""

# --- Google Analytics (GA4) ---
# Reuses GOOGLE_ADS_CLIENT_ID/SECRET above (same Cloud OAuth client — just
# add the analytics.readonly scope to it). Needs its own redirect URI since
# each callback route must be individually registered in Cloud Console.
# Also enable "Google Analytics Data API" and "Google Analytics Admin API"
# in the Cloud project.
GOOGLE_ANALYTICS_REDIRECT_URI="http://localhost:3010/api/google-analytics/callback"

# --- Google Tag Manager ---
# Same OAuth client again — add the tagmanager.readonly,
# tagmanager.edit.containers, and tagmanager.publish scopes. Enable the
# "Tag Manager API" in the Cloud project.
GOOGLE_TAG_MANAGER_REDIRECT_URI="http://localhost:3010/api/google-tag-manager/callback"

# --- Google Business Profile ---
# Same OAuth client again — add the business.manage scope (Google classifies
# it "Sensitive"). Enable "My Business Account Management API", "My Business
# Business Information API", "Business Profile Performance API", and "My
# Business API" in the Cloud project. Note: Business Profile APIs also
# require their own separate Google access-approval process (60+ day
# verified Business Profile + a business website) before quota is granted
# above 0 — connecting/syncing will fail with a quota error until then, see
# https://developers.google.com/my-business/content/prereqs
GOOGLE_BUSINESS_REDIRECT_URI="http://localhost:3010/api/google-business/callback"

# --- Meta (Facebook + Instagram) Marketing API ---
# A SEPARATE Meta developer app (business.facebook.com/developers) — not
# reused from anything Google-related. Needs the ads_management, ads_read,
# and business_management permissions. In Meta's default "Dev Tier" these
# only work against ad accounts your own app's developers/admins are already
# added to (fine for testing); real client accounts in production require
# Meta App Review for "Standard Access" — see lib/meta.ts for details.
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:3010/api/meta/callback"

# --- Snapchat Marketing API ---
# An OAuth app set up in Snap Business Manager (Business Details > developer
# apps — you need to be an Organization Admin to see this). Needs the
# snapchat-marketing-api scope. Unlike Meta, Snapchat issues a real,
# never-expiring refresh_token — no re-exchange-on-every-sync dance needed,
# see lib/snapchat.ts for details.
SNAPCHAT_CLIENT_ID=""
SNAPCHAT_CLIENT_SECRET=""
SNAPCHAT_REDIRECT_URI="http://localhost:3010/api/snapchat/callback"

# --- AI campaign generation ---
# Anthropic API key — used to turn a client's brief into a structured campaign draft
ANTHROPIC_API_KEY=""

# --- Background scheduler ---
# Required to enable automatic metrics sync + AI review (src/lib/scheduler.ts,
# started by src/instrumentation.ts when the server boots). Without this set,
# the scheduler skips every cycle and logs a warning — manual "Sync now" /
# "Run AI review" clicks in the dashboard still work either way.
# Generate with: openssl rand -hex 32
SYNC_SECRET=""
# How often the scheduler runs, in minutes. Default 240 (every 4 hours) if unset.
SYNC_INTERVAL_MINUTES="240"

# --- Marketing site email automation (Zoho SMTP) ---
# Used by src/lib/mailer.ts to send the two automated emails for
# /api/public/lead and /api/public/schedule-call: an internal notification
# to this same address, and a confirmation to whoever submitted the form.
# ZOHO_SMTP_PASS must be a Zoho "app-specific password" (Zoho account ->
# Security -> App Passwords — requires 2FA enabled first), never the
# account's real login password.
ZOHO_SMTP_USER="hello@adpac.to"
ZOHO_SMTP_PASS=""
ZOHO_SMTP_HOST="smtppro.zoho.com"
ZOHO_SMTP_PORT="465"

# Which origin is allowed to call /api/public/* (CORS). The marketing site
# lives on a different domain (adpac.to) than this app (app.adpac.to), so
# browser fetch() calls from it need this explicitly allowed rather than
# left to same-origin defaults.
PUBLIC_SITE_ORIGIN="https://adpac.to"
